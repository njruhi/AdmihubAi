{
  "name": "admihub-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AdmihubAi — মানবিক বিভাগ (Arts Unit) ভর্তি পরীক্ষার জন্য প্রিমিয়াম AI স্টাডি এজেন্ট ও লার্নিং প্ল্যাটফর্ম",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/logic.mjs && node scripts/smoke.mjs",
    "test:logic": "node scripts/logic.mjs",
    "test:render": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.456.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}